# ============================================================
# ArKex 2.0 — environment configuration
# Copy to .env and fill in values before running.
# ============================================================

# PostgreSQL password (change this in production!)
POSTGRES_PASSWORD=changeme_in_production

# HTTP port exposed on the host
PORT=8080

# LLM providers — at least one is required for agent execution.
# Tier 1/2 (Claude): fast triage and frontier reasoning
ANTHROPIC_API_KEY=

# Tier 1/2 fallback (OpenAI)
OPENAI_API_KEY=

# Tier 3 (local/uncensored): Ollama endpoint, e.g. http://host.docker.internal:11434
# Leave blank to disable Tier 3
OLLAMA_URL=

# Optional: pre-created Docker network for sandbox containers
# Leave blank to use Docker's default bridge
ARKEX_SANDBOX_NETWORK=

# Optional: HTTP proxy address for sandbox egress, e.g. 127.0.0.1:8118
ARKEX_PROXY_ADDR=
